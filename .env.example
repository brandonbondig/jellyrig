# Copy to .env and edit:   cp .env.example .env
# Nothing in .env is ever committed (.gitignore covers it).

# The user the stack runs as. Create a dedicated service account (README
# "Quick start") and put its uid/gid here - or your own uid/gid.
PUID=1000
PGID=1000

# Your timezone, e.g. Europe/Copenhagen
TZ=Etc/UTC

# ONE filesystem holding downloads AND library. This is what makes imports
# instant (hardlinks/renames). An SSD you can grow later is ideal.
DATA_ROOT=/data

# Where service configuration lives. The default keeps it next to the repo;
# an absolute path like /opt/jellyrig is also fine.
CONFIG_ROOT=./config

# Jellystat (watch statistics). Set your own values - the JWT secret should
# be long and random:   openssl rand -hex 32
JELLYSTAT_DB_USER=jellystat
JELLYSTAT_DB_PASSWORD=change-me
JELLYSTAT_JWT_SECRET=change-me-openssl-rand-hex-32
