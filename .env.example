# You do not need to create this file by hand - ./setup.sh asks for each
# value and writes .env for you. This file only documents what ends up there.
#
# .env is chmod 600 and git-ignored: it holds your provider password.

# --- who the containers run as -------------------------------------------
PUID=1000
PGID=1000
TZ=Europe/Copenhagen

# --- storage --------------------------------------------------------------
# ONE filesystem holding downloads AND library (see README section 2).
DATA_ROOT=/data
# Where each service keeps its settings and database. Back this up.
CONFIG_ROOT=./config

# --- your Usenet provider -------------------------------------------------
USENET_HOST=news.example.com
USENET_PORT=563
USENET_USER=
USENET_PASS=

# --- your indexer (Usenet search engine) ----------------------------------
# INDEXER_NAME must match Prowlarr's own name for it. Leave the key empty to
# skip and add the indexer in Prowlarr's UI later.
INDEXER_NAME=NZBgeek
INDEXER_API_KEY=

# --- the account you will log in with -------------------------------------
# Created in Jellyfin, then reused for Seerr.
ADMIN_USER=admin
ADMIN_PASS=

# --- generated automatically ----------------------------------------------
JELLYSTAT_DB_USER=jellystat
JELLYSTAT_DB_PASSWORD=
JELLYSTAT_JWT_SECRET=
